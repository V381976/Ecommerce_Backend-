# Server port
PORT=5000

# MongoDB connection string (Atlas ya local)
# e.g. mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ecommerce
MONGO_URI=

# JWT secret (koi bhi lambi random string)
JWT_SECRET=

# Frontend URLs jo backend call kar sakte hain (comma separated)
CLIENT_URL=http://localhost:5173,http://localhost:5174

# Razorpay keys (https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Cloudinary (https://console.cloudinary.com → Settings → API Keys)
# product images yahan upload hoti hain
CLOUDINARY_CLOUD_NAME=ebaeqf7y
CLOUDINARY_API_KEY=274286517443644
CLOUDINARY_API_SECRET=z1OXMmQqFXc0_5X5kp2Do1i5nUI

# ---------------- optional (added with the store upgrade) ----------------
# Database name inside the cluster (empty = the one in MONGO_URI, i.e. "test")
MONGO_DB_NAME=

# Public storefront URL used in emails / password-reset links (default: first CLIENT_URL)
STORE_URL=

# Razorpay webhook (Dashboard → Webhooks → URL: <backend>/payment/webhook, events payment.captured + payment.failed)
RAZORPAY_WEBHOOK_SECRET=

# Email (order updates, password reset, back-in-stock, price drops). Leave SMTP_HOST empty to disable.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="ShopEase <no-reply@yourdomain.com>"

# Behind a proxy/load balancer (Render, Nginx …) so rate limits see real client IPs
TRUST_PROXY=
# Timezone used to group sales reports by day/week/month
REPORT_TIMEZONE=Asia/Kolkata
# Set to 1 to disable background jobs (unpaid-order expiry, cart reminders)
DISABLE_JOBS=
NODE_ENV=development
